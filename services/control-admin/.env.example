# No production service reads this file. Set environment explicitly.
CONTROL_MODE=demo
CONTROL_PORT=8899
CONTROL_HOST=127.0.0.1
# Required only for a future, isolated Supabase deployment:
# CONTROL_DATABASE_URL=postgresql://DEDICATED_LOGIN:PRIVATE@HOST:5432/postgres
# CONTROL_SUPABASE_URL=https://PROJECT.supabase.co
# CONTROL_SUPABASE_ANON_KEY=PUBLIC_PROJECT_KEY
# The first release never activates production authority or camera services.

# Required for verified isolated staging:
# CONTROL_EXPECTED_PROJECT_REF=ISOLATED_BRANCH_REF
# CONTROL_DATABASE_CA_PATH=ABSOLUTE_PATH_TO_OFFICIAL_CA
# CONTROL_PUBLIC_ORIGIN=https://YOUR_PRIVATE_STAGING_DOMAIN
# Optional server-only Auth Admin key; never delivered to a browser:
# CONTROL_SUPABASE_SECRET_KEY=SERVER_ONLY_STAGING_SECRET
