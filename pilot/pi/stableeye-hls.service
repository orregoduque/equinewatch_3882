[Unit]
Description=Stable Eye single-camera HLS pilot (outbound HTTPS)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=stableeye
Group=stableeye
ExecStart=/usr/bin/python3 /opt/stableeye/pilot/pi/agent.py --config /etc/stableeye/hls-agent.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
RuntimeDirectory=stableeye-hls
RuntimeDirectoryMode=0700
UMask=0077
MemoryMax=256M
CPUQuota=100%
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/stableeye-hls
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
